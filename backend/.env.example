# Copy to .env and fill in real values for non-local environments.
# NEVER commit a real .env file - it is gitignored by default.

APP_NAME=PulmoGuard API
APP_VERSION=1.0.0
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Generate a strong secret for staging/production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=INSECURE-DEV-ONLY-CHANGE-ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ADMIN_USERNAME=admin
# Default hash below corresponds to password "changeme" - generate your own with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$ek9El6/Oa92uA1/5udEX3eWw/OUc/0I4a5mRV5DmtMBsshtZW4csm

ML_CONFIG_PATH=../ml/configs/config.yaml
ML_CHECKPOINT_PATH=../ml/outputs/checkpoints/pulmoguard_best.pt

RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_ENABLED=true
